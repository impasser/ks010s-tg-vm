# ==========================================
# 必填設定
# ==========================================
# Telegram Bot Token (向 @BotFather 申請)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# 你的 Azure 訂用帳戶 ID (Subscription ID)
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"

# 白名單：允許可操作的 Telegram User ID (多個用逗號分隔，留空則允許所有人)
ALLOWED_USERS="123456789,987654321"

# 超級管理員 Telegram User ID (擁有查看全域主機、為他人延長時間、強制刪除的最高權限)
ADMIN_USERS="123456789"

# 允許的群組 Chat ID (多個用逗號分隔，若以負號開頭如 -100123456789)
ALLOWED_GROUPS="-1001234567890"

# ==========================================
# 認證模式 (二選一，同一個映像檔自適應)：
# ==========================================
# 模式 A: 部署在 Azure Container Apps (推薦)
# -> 完全不要填寫下方 3 個參數，程式會自動使用 ACA 的 Managed Identity (受控識別)！

# 模式 B: 部署在其他地方 (如 NAS, 本地 Docker, 其他 VPS)
# -> 取消下方 3 行註解並填入 Azure 服務主體 (Service Principal) 的憑證：
# AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
# AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# AZURE_CLIENT_SECRET="your-service-principal-client-secret"

# ==========================================
# VM 與自動化自訂設定 (選填，均有預設值)
# ==========================================
AZURE_LOCATION="eastasia"                 # 部署區域：eastasia (香港), japaneast (東京), southeastasia (新加坡)
DEFAULT_VM_SIZE="Standard_B2s"            # VM 規格：Standard_B2s (2核4G), Standard_D2s_v5 (2核8G效能型)
OS_DISK_TYPE="StandardSSD_LRS"            # 磁碟等級：StandardSSD_LRS (標準SSD), Premium_LRS (高級SSD)
# 預設映像為 Windows Server 2022 (開機速度快、無客戶端授權限制)
IMAGE_PUBLISHER="MicrosoftWindowsServer"
IMAGE_OFFER="WindowsServer"
IMAGE_SKU="2022-datacenter-azure-edition"
IMAGE_VERSION="latest"
DEFAULT_LIFETIME_HOURS=2                  # 自動銷毀倒數小時 (已調整為 2 小時)
AUTO_SHUTDOWN_TIME="1900"                 # 每日自動關機時間 (1900 即 19:00)
AUTO_SHUTDOWN_TIMEZONE="Taipei Standard Time"
MAX_VMS_PER_USER=2                        # 每位同事同時擁有的上限 (最多 2 台)
MAX_TOTAL_VMS=2                           # 全局最多同時開機數 (最多 2 台)
